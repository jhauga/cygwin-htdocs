Redirect /faq.faq.html /faq/faq.html
Redirect /faq-nochunks.html /faq/faq.html

Redirect /bugs.html /problems.html
Redirect /cvs.html /git.html
Redirect /setup.html /packages.html
Redirect /packaging.html /packages.html
Redirect seeother /setup.exe /install.html
Redirect /setup-snapshots /setup/
Redirect gone /win-9x.html

Redirect /readme_toc.html /index.html
Redirect /license.html /licensing.html

Redirect /cygwin-pkg-maint /cgit/cygwin-infra/pkg-maint/plain/cygwin-pkg-maint

# discourage use of old setup versions by serving an empty mirrors list
# (versions >=2.890 support setup-minimum-version: so we can discourage them more directly)
RewriteEngine On
RewriteBase "/"
RewriteCond "%{HTTP_USER_AGENT}" "^Cygwin Setup$" [OR]
RewriteCond "%{HTTP_USER_AGENT}" "^Cygwin-Setup/2.88"
RewriteRule "^mirrors.lst$" "mirrors.empty.lst" [L,R]
